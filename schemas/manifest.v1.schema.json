{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://am.local/schemas/manifest.v1.schema.json",
  "title": "AM asset manifest v1",
  "type": "object",
  "required": ["format", "asset", "inputs", "files", "history"],
  "additionalProperties": true,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "crc32": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ts": { "type": "string", "format": "date-time" },
    "zipPath": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+$" },
    "origin": { "type": "string", "description": "user | file | measured | inferred[:detail] | plugin:<id>" },
    "valueStatus": { "enum": ["suggested", "computed", "confirmed"], "description": "ADR-0028, ТЗ §11.2.2" },
    "originDetail": {
      "type": "object",
      "description": "ADR-0028: who produced the value and on what basis (ТЗ §11.2.3)",
      "properties": {
        "handler": { "type": "string" },
        "handler_version": { "type": "string" },
        "basis": { "type": "string" },
        "analyzed_at": { "$ref": "#/$defs/ts" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "only for methods with a meaningful score" }
      },
      "additionalProperties": true
    },
    "src": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "name_raw_b64": { "type": ["string", "null"] },
        "size": { "type": "integer", "minimum": 0 },
        "packed_size": { "type": "integer", "minimum": 0 },
        "crc32": { "$ref": "#/$defs/crc32" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mtime": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "format": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "am-asset" },
        "version": { "type": "integer", "minimum": 1 },
        "min_reader": { "type": "integer", "minimum": 1 }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "revision", "created"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "created": { "$ref": "#/$defs/ts" },
        "modified": { "$ref": "#/$defs/ts" },
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "flags": {
          "type": "object",
          "properties": { "incomplete": { "type": "boolean" } }
        },
        "derived_from": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["telegram_channel", "telegram_message", "website", "repository", "marketplace", "patreon", "other"] },
              "name": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "origin": { "$ref": "#/$defs/origin" },
              "confirmed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^i[0-9]{3,}$" },
          "kind": { "enum": ["archive", "volume_set", "nested_archive", "file", "directory"] },
          "container": { "type": "string" },
          "original_name": { "type": "string" },
          "original_path": { "type": ["string", "null"] },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "parent": { "type": ["string", "null"] },
          "volumes": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["index", "original_name", "size", "sha256"],
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "original_name": { "type": "string" },
                "size": { "type": "integer" },
                "sha256": { "$ref": "#/$defs/sha256" },
                "missing": { "type": "boolean" }
              }
            }
          },
          "content_root": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "src"],
        "properties": {
          "id": { "type": "string", "pattern": "^f[0-9]{5,}$" },
          "input": { "type": "string" },
          "status": { "enum": ["included", "included_renamed", "excluded", "unreadable"] },
          "src": { "$ref": "#/$defs/src" },
          "zip_path": { "$ref": "#/$defs/zipPath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "rename": {
            "type": "object",
            "properties": { "reason": { "enum": ["path_too_long", "invalid_chars", "encoding", "collision", "reserved_name"] } }
          },
          "exclusion": {
            "type": "object",
            "required": ["rule"],
            "properties": {
              "rule": { "type": "string" },
              "by": { "enum": ["auto", "user", "profile"] },
              "rules_version": { "type": "integer" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["included", "included_renamed"] } } },
            "then": { "required": ["zip_path", "size", "sha256"] }
          },
          {
            "if": { "properties": { "status": { "const": "excluded" } } },
            "then": { "required": ["exclusion"] }
          }
        ]
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rev", "at", "op"],
        "properties": {
          "rev": { "type": "integer", "minimum": 1 },
          "at": { "$ref": "#/$defs/ts" },
          "op": { "type": "string" },
          "op_id": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    },
    "ext": { "type": "object", "additionalProperties": true }
  }
}
