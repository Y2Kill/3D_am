{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:0d40b3a5-39ae-48e6-a8e8-da18b1b8c128:manifest:1.0",
  "title": "AM asset manifest 1.0",
  "description": "Release candidate for TZ v1.8 section 19.4 (MF-01..MF-12), ADR-0035, ADR-0036 (R-01..R-09), ADR-0037 (decision log v0.11, 108 principles) and ADR-0039 (report 08: X-01, X-02, O-14, O-15, O-18 sub-details closed). Not a published schema: format 1.0 is published only together with a positive S7, the V1-V4 validator and golden ZIP fixtures. Semantic rules (reference resolution, history coverage, units) are V3 and not expressible here.",
  "type": "object",
  "required": ["format", "asset", "files", "history"],
  "additionalProperties": false,
  "properties": {
    "format": {"$ref": "#/$defs/format"},
    "asset": {"$ref": "#/$defs/asset"},
    "origin": {"$ref": "#/$defs/origin"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "historical_files": {"type": "array", "items": {"$ref": "#/$defs/historicalFile"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "previews": {"$ref": "#/$defs/previews"},
    "field_definitions": {"type": "array", "items": {"$ref": "#/$defs/fieldDefinition"}},
    "extensions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/extensionId"},
      "additionalProperties": {"$ref": "#/$defs/extension"}
    },
    "history": {"$ref": "#/$defs/history"}
  },
  "$defs": {
    "uuid4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crc32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Byte size as canonical decimal string; range 0..18446744073709551615 is checked by V3 (pattern only limits length)."
    },
    "int64String": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,18})$",
      "description": "Field value of type integer; int64 range is checked by V3."
    },
    "decimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "description": "Field value of type decimal: no exponent, trailing zeros preserved."
    },
    "safeInt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "YYYY-MM-DD; calendar validity is a V3 check."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Absolute URI: scheme followed by a non-empty, whitespace-free remainder. Full RFC 3986 parsing is a V3 check.",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "description": "UCUM code for known units; unknown units are kept verbatim (X-02). Unit conversion is an implementation capability, not part of the format (ADR-0039 item 3)."
    },
    "storagePath": {
      "type": "string",
      "minLength": 1,
      "description": "200-byte UTF-8 limit, NFC/casefold collisions and ADR-0012 character rules are checked by V3.",
      "pattern": "^(?!.*(^|/)\\.\\.?(/|$))(?!.*//)(content|generated|extensions)/[^\\\\]*[^/\\\\]$"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^(?=.{3,96}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "description": "O-11: lowercase ASCII reverse-domain, labels 1..63 without leading/trailing hyphen, 3..96 bytes. ExtensionID = PluginID."
    },
    "extensionId": {"$ref": "#/$defs/pluginId"},
    "fieldId": {
      "type": "string",
      "pattern": "^(?:user:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*)$",
      "description": "user:<UUIDv4> or plugin:<PluginID>:<FieldKey> (O-11); core: is reserved and therefore rejected."
    },
    "typeId": {
      "description": "One of the 11 core types or plugin:<PluginID>:<TypeKey> (O-11). TypeID and FieldID are different roles.",
      "anyOf": [
        {
          "enum": [
            "string",
            "text",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "enum",
            "multi_enum",
            "url",
            "file_ref"
          ]
        },
        {
          "type": "string",
          "pattern": "^plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"
        }
      ]
    },
    "relKey": {
      "description": "links[].rel (O-14 item 4, K-7): simple name or plugin:<PluginID>:<RelKey>. Open vocabulary, exact match.",
      "anyOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        {
          "type": "string",
          "pattern": "^plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"
        }
      ]
    },
    "rawName": {
      "type": "object",
      "required": ["base64"],
      "additionalProperties": false,
      "properties": {
        "encoding_guess": {"type": "string", "minLength": 1},
        "base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "description": "Strict RFC 4648 Base64 without line breaks (X-01 item 9). Size limit is O-17."
        }
      }
    },
    "problem": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "message_id": {"type": "string"}}
    },
    "format": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "urn:uuid:0d40b3a5-39ae-48e6-a8e8-da18b1b8c128"},
        "version": {
          "type": "object",
          "required": ["major", "minor"],
          "additionalProperties": false,
          "properties": {"major": {"const": 1}, "minor": {"const": 0}},
          "description": "Schema 1.0 accepts exactly 1.0. Newer minor versions go through the capability matrix (versioning.md), not through this schema (R-09.10)."
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "revision", "created_at", "modified_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "revision": {"$ref": "#/$defs/revision"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "modified_at": {"$ref": "#/$defs/timestamp"},
        "metadata": {"$ref": "#/$defs/metadata"}
      },
      "description": "V3 (O-14): created_at = timestamp of revision 1, modified_at = timestamp of the last history entry."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}}
    },
    "source": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "url": {"$ref": "#/$defs/url"},
        "published_at": {"$ref": "#/$defs/timestamp"},
        "retrieved_at": {"$ref": "#/$defs/timestamp"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/sourceClaim"}}
      }
    },
    "input": {
      "type": "object",
      "required": ["id", "imported_at", "mode", "completeness", "objects", "entries"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/uuid4"}, "uniqueItems": true},
        "imported_at": {"$ref": "#/$defs/timestamp"},
        "mode": {"enum": ["strict", "partial"]},
        "completeness": {
          "enum": ["complete", "incomplete", "unknown"],
          "description": "Actual completeness of the import act (X-01 item 2, K-5); independent of mode."
        },
        "objects": {"type": "array", "items": {"$ref": "#/$defs/inputObject"}},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/inputEntry"}}
      }
    },
    "inputObject": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "kind": {"enum": ["file", "directory", "archive", "multivolume_archive"]},
        "name": {"type": "string"},
        "name_raw": {"$ref": "#/$defs/rawName"},
        "relative_path": {"type": "string"},
        "size_bytes": {"$ref": "#/$defs/uint64"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "container": {
          "type": "string",
          "minLength": 1,
          "description": "Archive type detected by signature (zip, rar4, rar5, 7z, ...; ADR-0011). Only for archive kinds; not a nesting link (K-6)."
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "name"],
            "additionalProperties": false,
            "properties": {
              "index": {"$ref": "#/$defs/safeInt"},
              "name": {"type": "string"},
              "size_bytes": {"$ref": "#/$defs/uint64"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "missing": {"type": "boolean"}
            },
            "description": "index: unique, 0-based position of the volume in the set (X-01 item 4); uniqueness is V3."
          }
        },
        "parent_object_id": {"$ref": "#/$defs/uuid4"},
        "parent_entry_id": {"$ref": "#/$defs/uuid4"},
        "nested_action": {"enum": ["extract", "preserve", "exclude"]},
        "name_encoding": {
          "type": "string",
          "minLength": 1,
          "description": "How entry names inside this object were decoded, e.g. utf-8(bit11), cp866(heuristic) (ADR-0012, K-6)."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["file", "directory"]}}, "required": ["kind"]},
          "then": {"not": {"required": ["container"]}}
        }
      ]
    },
    "inputEntry": {
      "type": "object",
      "required": ["id", "object_id", "entry_kind", "path", "result"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "object_id": {"$ref": "#/$defs/uuid4"},
        "entry_kind": {"enum": ["file", "directory"], "description": "X-01 item 6, K-5."},
        "path": {"type": "string"},
        "path_raw": {"$ref": "#/$defs/rawName"},
        "size_bytes": {"$ref": "#/$defs/uint64"},
        "crc32": {"$ref": "#/$defs/crc32"},
        "modified_at_raw": {"type": "string"},
        "result": {"enum": ["included", "included_renamed", "excluded", "unavailable", "failed", "not_processed"]},
        "file_id": {"$ref": "#/$defs/uuid4"},
        "rename_reason": {"enum": ["path_too_long", "invalid_chars", "encoding", "collision", "reserved_name"]},
        "exclusion": {
          "type": "object",
          "required": ["rule", "by"],
          "additionalProperties": false,
          "properties": {
            "rule": {"type": "string"},
            "rules_version": {"$ref": "#/$defs/safeInt"},
            "by": {"enum": ["auto", "user", "profile"]}
          }
        },
        "problem": {"$ref": "#/$defs/problem"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"entry_kind": {"const": "file"}, "result": {"enum": ["included", "included_renamed"]}},
            "required": ["entry_kind", "result"]
          },
          "then": {"required": ["file_id"]}
        },
        {
          "if": {"properties": {"entry_kind": {"const": "directory"}}, "required": ["entry_kind"]},
          "then": {"not": {"required": ["file_id"]}}
        },
        {
          "if": {"properties": {"result": {"const": "included_renamed"}}, "required": ["result"]},
          "then": {"required": ["rename_reason"]}
        },
        {
          "if": {"properties": {"result": {"const": "excluded"}}, "required": ["result"]},
          "then": {"required": ["exclusion"]}
        },
        {
          "if": {"properties": {"result": {"enum": ["unavailable", "failed"]}}, "required": ["result"]},
          "then": {"required": ["problem"]}
        }
      ]
    },
    "fileRefWithHash": {
      "type": "object",
      "required": ["file_id", "sha256"],
      "additionalProperties": false,
      "properties": {"file_id": {"$ref": "#/$defs/uuid4"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "file": {
      "type": "object",
      "required": ["id", "storage_path", "size_bytes", "sha256", "origin_kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "storage_path": {"$ref": "#/$defs/storagePath"},
        "size_bytes": {"$ref": "#/$defs/uint64"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "origin_kind": {"enum": ["imported", "user_added", "generated"]},
        "type": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)*$", "description": "Open type identifier; the value registry is not part of the format (ADR-0039 item 10)."}, "by": {"enum": ["signature", "extension", "user"]}}
        },
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/fileRefWithHash"}},
        "generation": {
          "type": "object",
          "required": ["tool"],
          "additionalProperties": false,
          "properties": {
            "tool": {"description": "Stable handler ID: core:<Key> or plugin:<PluginID>:<Key> (ADR-0039 item 8).", "anyOf": [{"type": "string", "pattern": "^core:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"}, {"type": "string", "pattern": "^plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"}]},
            "tool_version": {"type": "string"},
            "params": {
              "type": "object",
              "description": "Persistent operation parameters; opaque numbers are covered by the exact-number guarantee (O-13)."
            }
          }
        },
        "metadata": {"$ref": "#/$defs/metadata"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin_kind": {"const": "generated"}}, "required": ["origin_kind"]},
          "then": {"required": ["generation"]},
          "else": {"not": {"required": ["generation"]}}
        }
      ],
      "description": "O-14 item 5: generation is required for generated files and absent otherwise."
    },
    "historicalFile": {
      "type": "object",
      "required": ["id", "removed_at_revision"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "removed_at_revision": {"$ref": "#/$defs/revision"},
        "last_known_sha256": {"$ref": "#/$defs/sha256"},
        "last_known_size_bytes": {"$ref": "#/$defs/uint64"},
        "last_known_storage_path": {"type": "string"}
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "name": {"type": "string"},
        "type": {"type": "string", "minLength": 1},
        "parent_id": {"$ref": "#/$defs/uuid4"},
        "file_refs": {"type": "array", "items": {"$ref": "#/$defs/uuid4"}, "uniqueItems": true},
        "metadata": {"$ref": "#/$defs/metadata"}
      },
      "description": "Readers treat a missing file_refs as []; writers always emit the array (ADR-0036 item 7)."
    },
    "previews": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "primary_id": {"$ref": "#/$defs/uuid4"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file_id"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/uuid4"},
              "file_id": {"$ref": "#/$defs/uuid4"},
              "group_refs": {"type": "array", "items": {"$ref": "#/$defs/uuid4"}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "fieldDefinition": {
      "type": "object",
      "required": ["id", "schema_revision", "name", "type", "scopes"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/fieldId"},
        "schema_revision": {"$ref": "#/$defs/revision"},
        "name": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/typeId"},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["asset", "group", "file"]}},
        "description": {"type": "string"},
        "dimension": {
          "description": "Semantic dimension key (X-02 item 3, ADR-0039 item 1): base key or plugin:<PluginID>:<Key>. Unknown valid keys are preserved; conversions exist only for the base registry.",
          "anyOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, {"type": "string", "pattern": "^plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"}]
        },
        "unit": {"$ref": "#/$defs/unit"},
        "constraints": {"description": "Closed structure per core type (X-02 item 6); opaque JSON for plugin types."},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "deprecated": {"type": "boolean"}
            }
          }
        },
        "default": {
          "description": "Recommendation only; checked like a value by V3. Integer/decimal fields with a physical dimension use {value, unit} (ADR-0039 item 2)."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "integer"}}, "required": ["type"]},
          "then": {
            "properties": {
              "default": {"anyOf": [{"$ref": "#/$defs/int64String"}, {"type": "object", "required": ["value", "unit"], "additionalProperties": false, "properties": {"value": {"$ref": "#/$defs/int64String"}, "unit": {"$ref": "#/$defs/unit"}}}]},
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/int64String"}, "unit": {"$ref": "#/$defs/unit"}}
                  },
                  "maximum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/int64String"}, "unit": {"$ref": "#/$defs/unit"}}
                  }
                },
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "decimal"}}, "required": ["type"]},
          "then": {
            "properties": {
              "default": {"anyOf": [{"$ref": "#/$defs/decimalString"}, {"type": "object", "required": ["value", "unit"], "additionalProperties": false, "properties": {"value": {"$ref": "#/$defs/decimalString"}, "unit": {"$ref": "#/$defs/unit"}}}]},
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/decimalString"}, "unit": {"$ref": "#/$defs/unit"}}
                  },
                  "maximum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/decimalString"}, "unit": {"$ref": "#/$defs/unit"}}
                  }
                },
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["string", "text"]}}, "required": ["type"]},
          "then": {
            "properties": {
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"min_length": {"$ref": "#/$defs/safeInt"}, "max_length": {"$ref": "#/$defs/safeInt"}},
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "date"}}, "required": ["type"]},
          "then": {
            "properties": {
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/date"}}
                  },
                  "maximum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/date"}}
                  }
                },
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "datetime"}}, "required": ["type"]},
          "then": {
            "properties": {
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/timestamp"}}
                  },
                  "maximum": {
                    "type": "object",
                    "required": ["value"],
                    "additionalProperties": false,
                    "properties": {"value": {"$ref": "#/$defs/timestamp"}}
                  }
                },
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "multi_enum"}}, "required": ["type"]},
          "then": {
            "properties": {
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"min_items": {"$ref": "#/$defs/safeInt"}, "max_items": {"$ref": "#/$defs/safeInt"}},
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["boolean", "url", "file_ref", "enum"]}}, "required": ["type"]},
          "then": {"not": {"required": ["constraints"]}}
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/uuid4",
                "description": "Optional; required by V3 when a claim targets this author (R-03)."
              },
              "name": {"type": "string"},
              "role": {"type": "string"}
            }
          }
        },
        "publisher": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1}, "url": {"$ref": "#/$defs/url"}},
          "description": "ADR-0036 item 7; unchanged by O-14 item 1."
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "spdx": {
              "type": "string",
              "minLength": 1,
              "description": "SPDX license expression; grammar is a V3 check (O-14 item 3)."
            },
            "url": {"$ref": "#/$defs/url"},
            "notice": {"type": "string", "minLength": 1},
            "file_ref": {"$ref": "#/$defs/uuid4"}
          },
          "minProperties": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"},
          "description": "Exact user spelling (R-08.1). Exact duplicates are invalid; case variants are allowed (search-key collisions are a V3 warning)."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {"path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "rel"],
            "additionalProperties": false,
            "properties": {"url": {"$ref": "#/$defs/url"}, "rel": {"$ref": "#/$defs/relKey"}}
          }
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"published": {"$ref": "#/$defs/date"}, "acquired": {"$ref": "#/$defs/date"}},
          "description": "O-02 item 3: acquired = first acquisition of the described object, not addition to the library."
        },
        "custom_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_id", "value"],
            "additionalProperties": false,
            "properties": {
              "field_id": {"$ref": "#/$defs/fieldId"},
              "value": {},
              "unit": {"$ref": "#/$defs/unit"},
              "dependencies": {"$ref": "#/$defs/dependencies"}
            },
            "description": "dependencies apply to plugin-typed values (O-12); unit is required by V3 for physical numeric fields (X-02 item 4)."
          }
        },
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      },
      "description": "One set of standard fields for asset, group and file; no inheritance between levels (O-02 item 1)."
    },
    "claimCore": {
      "type": "object",
      "required": ["id", "target", "relation", "method", "created_at"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid4"},
        "target": {},
        "relation": {"enum": ["supports_selected", "alternative", "rejected"]},
        "value": {},
        "unit": {"$ref": "#/$defs/unit", "description": "Unit of value for a physical integer/decimal custom field; required there by V3 (ADR-0039 item 4)."},
        "method": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "file_id": {"$ref": "#/$defs/uuid4"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "source_entry_id": {"$ref": "#/$defs/uuid4"},
              "input_object_id": {"$ref": "#/$defs/uuid4"},
              "source_id": {"$ref": "#/$defs/uuid4"},
              "note": {"type": "string"}
            }
          }
        },
        "handler": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
        },
        "confidence": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
        "review": {
          "type": "object",
          "required": ["at"],
          "additionalProperties": false,
          "properties": {"at": {"$ref": "#/$defs/timestamp"}},
          "description": "Fact and time of an explicit user review (O-01); there is no state."
        },
        "created_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"relation": {"enum": ["alternative", "rejected"]}}, "required": ["relation"]},
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"relation": {"const": "supports_selected"}}, "required": ["relation"]},
          "then": {"not": {"required": ["value"]}}
        },
        {
          "if": {"properties": {"relation": {"const": "rejected"}}, "required": ["relation"]},
          "then": {"required": ["review"]}
        },
        {
          "if": {
            "properties": {"target": {"properties": {"kind": {"const": "self"}}, "required": ["kind"]}},
            "required": ["target"]
          },
          "then": {"properties": {"relation": {"const": "supports_selected"}}}
        }
      ],
      "description": "Shared claim rules (O-01). Wrappers claim/sourceClaim add the target registry and close the object."
    },
    "claim": {
      "$ref": "#/$defs/claimCore",
      "properties": {"target": {"$ref": "#/$defs/claimTarget"}},
      "unevaluatedProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"target": {"properties": {"kind": {"const": "standard_item"}}, "required": ["kind"]}},
            "required": ["target"]
          },
          "then": {"properties": {"relation": {"const": "supports_selected"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "title"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"type": "string"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "description"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"type": "string"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "authors"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/authors"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "publisher"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/publisher"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "license"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/license"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "tags"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/tags"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "categories"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/categories"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "links"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/links"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "dates"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/metadata/properties/dates"}}}
        }
      ]
    },
    "sourceClaim": {
      "$ref": "#/$defs/claimCore",
      "properties": {"target": {"$ref": "#/$defs/sourceClaimTarget"}},
      "unevaluatedProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "kind"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "name"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"type": "string"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "url"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/url"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "published_at"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/timestamp"}}}
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {"kind": {"const": "standard"}, "field": {"const": "retrieved_at"}},
                "required": ["kind", "field"]
              }
            },
            "required": ["target", "value"]
          },
          "then": {"properties": {"value": {"$ref": "#/$defs/timestamp"}}}
        }
      ],
      "description": "Claims of origin.sources[] use their own registry (O-02 item 7): standard and self only."
    },
    "claimTarget": {
      "description": "Typed claim target (R-01..R-03, O-02). standard addresses the whole field; standard_item addresses only authors[]. Resolution is V3.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "field"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "standard"},
            "field": {
              "enum": [
                "title",
                "description",
                "authors",
                "publisher",
                "license",
                "tags",
                "categories",
                "links",
                "dates"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "field", "item_id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "standard_item"},
            "field": {"const": "authors"},
            "item_id": {"$ref": "#/$defs/uuid4"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "field_id"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "custom"}, "field_id": {"$ref": "#/$defs/fieldId"}}
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "self"}}
        }
      ]
    },
    "sourceClaimTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "field"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "standard"},
            "field": {"enum": ["kind", "name", "url", "published_at", "retrieved_at"]}
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "self"}}
        }
      ]
    },
    "dependencyRef": {
      "description": "Typed in-asset reference (O-12 item 4).",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "file_id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "file"},
            "file_id": {"$ref": "#/$defs/uuid4"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "group_id"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "group"}, "group_id": {"$ref": "#/$defs/uuid4"}}
        },
        {
          "type": "object",
          "required": ["kind", "owner_scope", "owner_id", "field_id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "field_value"},
            "owner_scope": {"enum": ["asset", "group", "file"]},
            "owner_id": {"$ref": "#/$defs/uuid4"},
            "field_id": {"$ref": "#/$defs/fieldId"}
          }
        }
      ]
    },
    "dependencies": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["none", "declared", "unknown"]},
        "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dependencyRef"}}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "none"}}, "required": ["state"]},
          "then": {"properties": {"refs": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"state": {"const": "declared"}}, "required": ["state"]},
          "then": {"required": ["refs"], "properties": {"refs": {"minItems": 1}}}
        }
      ],
      "description": "O-12: one form for extensions and plugin-typed custom values; missing object = unknown. Writers sort refs (K-9), readers accept any order."
    },
    "extension": {
      "type": "object",
      "required": ["schema_version"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the extension's data contract (O-14 item 7); not a number, not SemVer."
        },
        "data": {"description": "Opaque plugin JSON; exact-number guarantee applies (O-13)."},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "size_bytes", "sha256"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/uuid4"},
              "path": {"type": "string", "pattern": "^extensions/"},
              "size_bytes": {"$ref": "#/$defs/uint64"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "dependencies": {"$ref": "#/$defs/dependencies"}
      }
    },
    "compactedRangeSummary": {
      "type": "object",
      "required": ["revision_count"],
      "additionalProperties": false,
      "properties": {
        "revision_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "operation_counts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "asset_created",
              "files_changed",
              "metadata_changed",
              "groups_changed",
              "previews_changed",
              "provenance_changed",
              "field_definitions_changed",
              "extension_data_changed",
              "format_migrated",
              "history_compacted",
              "session_committed"
            ]
          },
          "additionalProperties": {"$ref": "#/$defs/safeInt"}
        }
      },
      "description": "O-18 item 5: revision_count = to - from + 1; operation_counts sum = revision_count (V3)."
    },
    "history": {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": {
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revisionRecord"}},
        "compacted_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_revision", "to_revision", "summary"],
            "additionalProperties": false,
            "properties": {
              "from_revision": {"$ref": "#/$defs/revision"},
              "to_revision": {"$ref": "#/$defs/revision"},
              "summary": {"$ref": "#/$defs/compactedRangeSummary"}
            }
          }
        }
      },
      "description": "O-18: revisions 1..asset.revision covered exactly once; revision 1 and the last are separate entries (V3)."
    },
    "revisionRecord": {
      "type": "object",
      "required": ["revision", "operation_id", "timestamp", "operation"],
      "additionalProperties": false,
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "operation_id": {"$ref": "#/$defs/uuid4"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "operation": {
          "description": "Base vocabulary in SPEC 11 (O-18 item 4); other valid names and plugin:<PluginID>:<Key> are preserved with unknown semantics (ADR-0039 item 6).",
          "anyOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, {"type": "string", "pattern": "^plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"}]
        },
        "details": {"type": "object", "description": "Opaque operation parameters; exact-number guarantee applies."},
        "tool": {
          "type": "object",
          "required": ["application_version"],
          "additionalProperties": false,
          "properties": {
            "application_version": {"type": "string"},
            "profile": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "version": {"$ref": "#/$defs/safeInt"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "handlers": {"type": "object", "additionalProperties": {"type": "string"}},
            "exclusion_rules_version": {"$ref": "#/$defs/safeInt"}
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": true,
            "properties": {
              "kind": {"anyOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, {"type": "string", "pattern": "^plugin:(?=[^:]{3,96}:)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+:(?=[^:]{1,64}$)[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"}]},
              "target": {"type": "string"}
            },
            "description": "changes[].kind: base vocabulary in SPEC 11 (ADR-0039 item 5); other valid names and plugin kinds are preserved with unknown semantics; extra keys are opaque."
          }
        }
      }
    }
  }
}
