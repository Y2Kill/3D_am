{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:am:diagnostics:v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "am-diagnostics"
    },
    "version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "build": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "build"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "os",
        "os_version",
        "arch",
        "cpu_count"
      ],
      "additionalProperties": false
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^am-\\d{8}T\\d{6}Z-\\d+(\\.\\d+)?\\.jsonl$"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "dropped_lines": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "records",
          "dropped_lines"
        ],
        "additionalProperties": false
      }
    },
    "library": {
      "type": "object",
      "properties": {
        "entry": {
          "const": "library.json"
        }
      },
      "required": [
        "entry"
      ],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "salted": {
          "const": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "salted",
        "rules"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "created_at",
    "app",
    "system",
    "logs",
    "redaction"
  ],
  "additionalProperties": false
}
