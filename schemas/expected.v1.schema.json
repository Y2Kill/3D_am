{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Manager golden ZIP expectation, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "kind", "case", "description", "req", "input", "checks"],
  "properties": {
    "format": {"const": "am-expected"},
    "version": {"const": 1},
    "kind": {"enum": ["golden_zip"]},
    "case": {"type": "string", "pattern": "^(pos|neg)-(?:[a-z0-9_-]+)$"},
    "description": {"type": "string", "minLength": 1},
    "req": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["zip"],
      "properties": {"zip": {"const": "asset.zip"}}
    },
    "checks": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "args", "exit_code", "json"],
        "properties": {
          "command": {"enum": ["inspect", "validate", "verify"]},
          "args": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 4},
          "json": {"type": "object"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"command": {"const": "validate"}}}},
        {"contains": {"properties": {"command": {"const": "verify"}, "args": {"const": ["--level", "full"]}}}}
      ]
    }
  }
}
